{
  "name": "koma-monad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "lint": "eslint",
    "chain": "sh scripts/chain.sh",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy": "cd contracts && forge script script/DeployLaunchpad.s.sol --rpc-url ${RPC_URL:-https://testnet-rpc.monad.xyz} --broadcast",
    "buy": "node scripts/buy-comic.mjs",
    "contracts:test:fork": "cd contracts && FORK_TESTS=1 forge test --match-path 'test/fork/*'",
    "test:api": "node scripts/e2e-api.mjs",
    "test:launchpad": "node scripts/e2e-launchpad.mjs",
    "check:economics": "node scripts/check-economics.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:ai": "node scripts/e2e-ai.mjs",
    "chain:setup": "sh scripts/local-setup.sh",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mts",
    "test:autopilot": "node scripts/e2e-autopilot.mjs",
    "test:envio": "node scripts/e2e-envio.mjs",
    "test:cre": "node scripts/e2e-cre.mjs",
    "test:room": "node scripts/e2e-room.mjs",
    "test:walk": "node scripts/e2e-walk.mjs",
    "test:browser": "node scripts/e2e-browser.mjs",
    "demo": "sh scripts/demo.sh",
    "demo:stop": "sh scripts/demo-stop.sh"
  },
  "dependencies": {
    "@category-labs/mera": "^0.2.0",
    "@noble/curves": "^1.9.1",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.47.0",
    "@privy-io/wagmi": "^4.0.18",
    "@stripe/stripe-js": "^10.0.0",
    "@tanstack/react-query": "^5.104.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "@x402/next": "^2.27.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.9",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
