{
  "name": "koma-arc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "lint": "eslint",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy": "sh scripts/deploy.sh",
    "buy": "node scripts/buy-comic.mjs",
    "test:api": "node scripts/e2e-api.mjs",
    "test:launchpad": "node scripts/e2e-launchpad.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:ai": "node scripts/e2e-ai.mjs",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mts",
    "test:envio": "node scripts/e2e-envio.mjs",
    "test:room": "node scripts/e2e-room.mjs",
    "test:walk": "node scripts/e2e-walk.mjs",
    "test:browser": "node scripts/e2e-browser.mjs",
    "setup:testnet": "sh scripts/testnet-setup.sh",
    "demo": "sh scripts/demo.sh",
    "demo:stop": "sh scripts/demo-stop.sh",
    "dryrun:mainnet": "node --import ./scripts/dryrun-loader.mjs scripts/dryrun-mainnet.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@tanstack/react-query": "^5.104.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "@x402/next": "^2.27.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.9",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
