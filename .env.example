# KOMA on Monad. Copy to .env.local. Every sponsor integration is env-gated: leave a key empty and that part
# runs in a labelled mock/fallback mode (see docs/SPONSOR-GAP.md). Never commit real values.

# ——— Chain ————————————————————————————————————————————————————————————————————————————————
# monad-testnet (10143, default), monad (143), or koma-localnet (the anvil fork from scripts/chain.sh)
NEXT_PUBLIC_KOMA_NETWORK=monad-testnet
# Browser + server RPC. Local fork: http://127.0.0.1:18643
NEXT_PUBLIC_MONAD_RPC_URL=
# Optional server-only RPC (relayer, keeper, indexer, facilitator) so a keyed URL never reaches the browser
KOMA_SERVER_RPC_URL=
# Optional RPC for log scans (the public testnet RPC caps eth_getLogs at 100 blocks)
KOMA_LOGS_RPC_URL=
# Optional explorer override (defaults to the network's; empty on the local fork)
NEXT_PUBLIC_EXPLORER_URL=

# Server key: relays gasless trades (pays MON gas), settles x402 payments, holds MINTER_ROLE on KomaIssues
SERVER_PRIVATE_KEY=
# KomaIssues address (written by the deploy script into the addresses file)
KOMA_CONTRACT=
# Launchpad address book from contracts/script/DeployLaunchpad.s.sol
KOMA_LAUNCHPAD_ADDRESSES=.data/addresses.local.json
# Where AUSD from comic sales goes (defaults to the server key's address)
KOMA_PAY_TO=

# ——— AI (Track 3: Tencent Hunyuan + Kimi) ——————————————————————————————————————————————————
# No key for a role → the studio says it isn't configured (no placeholder output).
# Kimi (Moonshot) writes the comic scripts, with a get_series_canon tool call for series episodes (direct API)
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
# Tencent Hunyuan (TokenHub, OpenAI-compatible) runs the editor chat
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy3
# Panel art on fal. HUNYUAN_IMAGE=1 draws character sheets and covers with Hunyuan Image 3 on fal
FAL_KEY=
HUNYUAN_IMAGE=1
# Covers by Hunyuan Image 3 as well ($0.10 each; a 1-page issue then costs ~$0.15 to make). 0 = FLUX.2 covers
HUNYUAN_COVERS=1
# Daily cap on estimated fal spend (USD)
KOMA_FAL_DAILY_USD=5
# With only FAL_KEY, Kimi and Hunyuan run through fal's OpenAI-compatible OpenRouter endpoint (same models)
# Reasoning on the fal route: off for Kimi (KIMI_REASONING=on), on for Hunyuan (HUNYUAN_REASONING=off)
KIMI_FAL_MODEL=moonshotai/kimi-k2.6
HUNYUAN_FAL_MODEL=tencent/hy3

# ——— Privy (login, gas sponsorship, autopilot session signer) ——————————————————————————————
# Client: email / Google / passkey login with an embedded wallet; its transactions are sent with sponsor: true
NEXT_PUBLIC_PRIVY_APP_ID=
# Server: the backer autopilot signs as a Privy session signer under a per-backer policy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization private key of the key quorum below (dashboard → Authorization keys)
PRIVY_AUTHORIZATION_KEY=
# Key quorum id backers add as a signer on their embedded wallet
PRIVY_SIGNER_ID=

# ——— Envio HyperIndex ——————————————————————————————————————————————————————————————————————
# GraphQL endpoint of the indexer in indexer/ (local: http://localhost:8093/v1/graphql). Empty: SQLite fallback
ENVIO_GRAPHQL_URL=

# ——— App ———————————————————————————————————————————————————————————————————————————————————
# Public origin, used in token metadata
KOMA_PUBLIC_URL=http://localhost:4320
# Where issues, jobs and art are stored
KOMA_DATA_DIR=.data

# ——— Local fork only (scripts/local-setup.sh writes these with fresh keys) ———————————————————
KOMA_FORK_BLOCK=
SERVER_ADDRESS=
TEST_BROWSER_KEY=
TEST_BROWSER_ADDRESS=
TEST_AGENT_KEY=
TEST_AGENT_ADDRESS=
TEST_EMPTY_KEY=
TEST_EMPTY_ADDRESS=
TEST_PAYTO_KEY=
TEST_PAYTO_ADDRESS=
