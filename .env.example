# KOMA on Arc. Copy to .env.local (gitignored) or run `sh scripts/testnet-setup.sh`, which writes the keys for you.
# Never commit real values.

# ——— Chain ————————————————————————————————————————————————————————————————————————————————
# arc-testnet (5042002, default) or arc (mainnet, 5042). Inlined into the browser bundle at build time.
NEXT_PUBLIC_KOMA_NETWORK=arc-testnet
# Browser + server RPC (default: https://rpc.testnet.arc.io / https://rpc.mainnet.arc.io)
NEXT_PUBLIC_ARC_RPC_URL=
# Optional server-only RPC (relayer, keeper, indexer, facilitator) so a keyed URL never reaches the browser
KOMA_SERVER_RPC_URL=
# Optional RPC for log scans (Arc's public RPC caps eth_getLogs at 10,000 blocks; the indexer chunks to that)
KOMA_LOGS_RPC_URL=
# Optional explorer override (default: https://explorer.testnet.arc.io / https://explorer.arc.io)
NEXT_PUBLIC_EXPLORER_URL=

# Server key: settles x402 payments, relays gasless trades, runs the canon keeper, mints issues. Pays gas in USDC.
# Its address is the deploy script's RELAYER (MINTER_ROLE on KomaIssues, LAUNCHER_ROLE, canon RELAYER_ROLE).
SERVER_PRIVATE_KEY=
SERVER_ADDRESS=
# Contract addresses from the deploy script (default: deployments/arc-testnet.json or deployments/arc-mainnet.json)
KOMA_LAUNCHPAD_ADDRESSES=
# KomaIssues address; defaults to komaIssues in the deployments file
KOMA_CONTRACT=
# Where USDC from comic sales and launches goes (defaults to the server key's address)
KOMA_PAY_TO=

# ——— AI ———————————————————————————————————————————————————————————————————————————————————
# No key for a role → the studio says it isn't configured (no placeholder output).
# Kimi (Moonshot) writes the comic scripts, with a get_series_canon tool call for series episodes (direct API)
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
# Tencent Hunyuan (TokenHub, OpenAI-compatible) runs the editor chat
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy3
# Panel art on fal. HUNYUAN_IMAGE=1 draws character sheets and covers with Hunyuan Image 3 on fal
FAL_KEY=
HUNYUAN_IMAGE=1
# Covers by Hunyuan Image 3 as well ($0.10 each). 0 = FLUX.2 covers
HUNYUAN_COVERS=1
# Daily cap on estimated fal spend (USD)
KOMA_FAL_DAILY_USD=5
# With only FAL_KEY, Kimi and Hunyuan run through fal's OpenAI-compatible OpenRouter endpoint (same models)
# Reasoning on the fal route: off for Kimi (KIMI_REASONING=on), on for Hunyuan (HUNYUAN_REASONING=off)
KIMI_FAL_MODEL=moonshotai/kimi-k2.6
HUNYUAN_FAL_MODEL=tencent/hy3

# ——— Envio HyperIndex (optional) ———————————————————————————————————————————————————————————
# GraphQL endpoint of the indexer in indexer/ (local: http://localhost:8093/v1/graphql). Empty: SQLite index
ENVIO_GRAPHQL_URL=

# ——— App ———————————————————————————————————————————————————————————————————————————————————
# Public origin, used in token metadata (and by the deploy script for BASE_URI / KOMA_BASE_URI)
KOMA_PUBLIC_URL=http://localhost:4310
# Where issues, jobs and art are stored (SQLite + files; one instance on a persistent volume)
KOMA_DATA_DIR=.data
# Global hourly caps: editor chat turns and relayed trades (per-IP limits are fixed in code)
KOMA_CHAT_PER_HOUR=600
KOMA_RELAY_PER_HOUR=1500
# Indexer poll interval (ms) and log-scan chunk (blocks)
KOMA_INDEX_MS=3000
KOMA_INDEX_CHUNK=10000

# ——— Testnet e2e wallets (scripts/testnet-setup.sh writes these; testnet USDC only) —————————————
TEST_BROWSER_KEY=
TEST_BROWSER_ADDRESS=
TEST_AGENT_KEY=
TEST_AGENT_ADDRESS=
TEST_PAYTO_KEY=
TEST_PAYTO_ADDRESS=
TEST_EMPTY_KEY=
TEST_EMPTY_ADDRESS=

# ——— Deploy (scripts/deploy.sh; read from the shell, never stored here) ————————————————————————
# DEPLOYER_ENV   path to a file defining DEPLOYER_PRIVATE_KEY (default ../.deployer/deployer.env)
# RELAYER        server key address (default SERVER_ADDRESS above)
# ADMIN, TREASURY, CONFIRM_MAINNET=yes   mainnet only (see MAINNET.md)
